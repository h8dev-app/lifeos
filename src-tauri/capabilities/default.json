{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions of the overlay window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "autostart:allow-is-enabled",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/notes"
        },
        {
          "path": "$APPDATA/notes/**"
        }
      ]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-stat",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:11434/*"
        },
        {
          "url": "http://127.0.0.1:11434/*"
        },
        {
          "url": "http://localhost:5600/*"
        },
        {
          "url": "http://127.0.0.1:5600/*"
        }
      ]
    }
  ]
}
