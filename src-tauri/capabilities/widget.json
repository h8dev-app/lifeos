{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "widget",
  "description": "Permissions of the screen widgets (small windows in their own process)",
  "windows": [
    "widget-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/notes"
        },
        {
          "path": "$APPDATA/notes/**"
        }
      ]
    },
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-stat"
  ]
}
